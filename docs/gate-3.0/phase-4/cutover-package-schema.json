{
  "schema_version": "1.0.0",
  "required_fields": [
    "package_id",
    "route_or_subsystem",
    "phase_1_truth_evidence",
    "phase_2_functionality_evidence",
    "phase_2_intent_evidence",
    "phase_2_design_evidence",
    "phase_2_processing_evidence",
    "phase_3_target_owner",
    "current_owners",
    "superseded_owners",
    "activation_changes",
    "retirement_changes",
    "runtime_asset_delta",
    "semantic_parity_results",
    "automated_regression_results",
    "manual_operational_validation",
    "accessibility_validation",
    "responsive_validation",
    "data_integrity_validation",
    "audit_and_archive_validation",
    "rollback_plan",
    "rollback_trigger",
    "reference_scan_results",
    "runtime_unreachability_proof",
    "stabilization_window",
    "phase_5_evidence_outputs",
    "approval_status"
  ],
  "approval_status_values": [
    "draft",
    "blocked",
    "ready-for-cutover",
    "activated-stabilizing",
    "rollback-executed",
    "retirement-verified",
    "phase-5-ready"
  ],
  "hard_gates": {
    "all_prior_phase_evidence_required": true,
    "exactly_one_target_owner_required": true,
    "semantic_parity_required": true,
    "automated_regression_required": true,
    "manual_operational_validation_required": true,
    "rollback_test_required": true,
    "runtime_asset_delta_must_be_nonpositive": true,
    "superseded_owner_retirement_required": true,
    "reference_scan_required": true,
    "runtime_unreachability_proof_required": true,
    "permanent_dual_execution_prohibited": true
  },
  "rejection_conditions": [
    "assumption-only evidence",
    "unknown current owner",
    "unknown downstream consumer",
    "positive active runtime asset delta without approved compensating retirement",
    "client-only authorization for privileged behavior",
    "offline critical mutation without authorization",
    "missing rollback trigger",
    "legacy owner remains authoritative after activation",
    "unresolved record-identity or ordering risk",
    "unverified archive or report parity"
  ]
}
